{
  "name": "matrixtrim",
  "version": "0.19.0",
  "description": "Evidence-based GitHub Actions matrix diagnostics and optimization.",
  "type": "module",
  "bin": {
    "matrixtrim": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "check": "npm run build && npm run lint && npm test",
    "quality": "npm run check && npm run audit && npm run test:coverage && npm run pack:check",
    "build:action": "esbuild src/action.ts --bundle --platform=node --target=node24 --outfile=action-dist/index.cjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "audit": "npm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eburairu/matrixtrim.git"
  },
  "homepage": "https://github.com/eburairu/matrixtrim#readme",
  "bugs": {
    "url": "https://github.com/eburairu/matrixtrim/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
