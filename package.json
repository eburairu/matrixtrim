{
  "name": "matrixtrim",
  "version": "0.13.0",
  "description": "Evidence-based GitHub Actions matrix diagnostics and optimization.",
  "type": "module",
  "bin": {
    "matrixtrim": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "build:action": "esbuild src/action.ts --bundle --platform=node --target=node24 --outfile=action-dist/index.cjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
